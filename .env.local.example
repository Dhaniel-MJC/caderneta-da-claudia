# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# Onde achar: Supabase > Project Settings > API (Project URL e a chave anon/public).
# Nunca coloque aqui a chave service_role: ela ignora o RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
